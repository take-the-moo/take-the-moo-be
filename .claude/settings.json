{
  "permissions": {
    "allow": [
      "Bash(./gradlew compileJava:*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew build:*)",
      "Bash(./gradlew bootRun:*)",
      "Bash(LLM_MOCK=true ./gradlew bootRun:*)",
      "Bash(curl *localhost*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git config core.hooksPath:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/compile-check.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
