# EC2 배포용 HTTPS 앞단 (compose.prod.yml의 caddy). 인증서는 Let's Encrypt에서 자동으로 받고 갱신한다.
# DOMAIN은 서버 ~/app/.env에 있다 (scripts/deploy-ec2.sh가 IP로 <a-b-c-d>.sslip.io를 만든다)
# 한 주소에서 백엔드(/api, Swagger)와 프론트(그 밖의 모든 경로)를 함께 낸다 — 같은 출처라 CORS가 필요 없다
{$DOMAIN} {
	encode gzip

	@backend path /api/* /swagger-ui* /v3/api-docs*
	handle @backend {
		reverse_proxy api:8080
	}

	# 프론트(Next.js, compose.prod.yml의 web). 프론트를 배포하지 않은 서버에서는 502가 난다
	handle {
		reverse_proxy web:3000
	}
}
